// InboxPilot database schema
// Local dev: SQLite (file:./db/custom.db)
// Vercel/production: switch provider to "postgresql" and set DATABASE_URL to
// a serverless Postgres (Vercel Postgres, Supabase, Neon, Turso pg, etc.).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  toneProfile  String?   // JSON-serialized ToneProfile
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accounts     Account[]
}

model Account {
  // Linked email providers (Gmail, Outlook, IMAP). Stores OAuth tokens.
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // "gmail" | "outlook" | "imap"
  email        String   // the connected address
  accessToken  String
  refreshToken String?
  expiryDate    Int?    // epoch ms
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, provider, email])
}
