# InboxPilot environment variables
# Copy to `.env.local` (local) or set in Vercel (Settings -> Environment Variables).

# ---- App ----
# Local dev: SQLite file. Vercel: use a serverless Postgres URL and change the
# provider in prisma/schema.prisma to "postgresql".
DATABASE_URL=file:./db/custom.db

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# The canonical app URL (http://localhost:3000 locally; your Vercel URL in prod)
NEXTAUTH_URL=http://localhost:3000

# ---- AI (shared across all users) ----
# xAI Grok API key from https://x.ai. If set, Grok powers all AI features.
# If empty, InboxPilot falls back to its built-in model (no key required).
# All AI endpoints are auth-gated so only logged-in users can consume the key.
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# ---- Gmail OAuth (optional — enables "Connect Gmail") ----
# Create at https://console.cloud.google.com/ — see README "Gmail setup".
# Leave empty to run without Gmail integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
