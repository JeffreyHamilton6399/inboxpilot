# InboxPilot environment variables
# Copy this file to `.env.local` for local development, or set these in your
# Vercel project (Settings -> Environment Variables).

# (Optional) xAI Grok API key.
# If set, InboxPilot uses Grok (https://x.ai) for all AI features.
# If left EMPTY, InboxPilot falls back to its built-in model — no key required.
GROK_API_KEY=

# (Optional) Which Grok model to use. Defaults to grok-2-latest.
GROK_MODEL=grok-2-latest

# (Optional, local dev only) SQLite database URL. The core demo app does not
# require a database; this is only used if you extend the app with Prisma.
DATABASE_URL=file:./db/custom.db
