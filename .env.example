# Copy to `.env` for local development, or paste into Vercel's environment
# variables for a deployment. Every value below is required except where noted.

# ---- Database (Supabase Postgres) ----
# Vercel's filesystem is ephemeral, so SQLite is not an option. Supabase's free
# tier is what this is written against, but any Postgres works.
#
#   Supabase → Project Settings → Database → Connection string
#   DATABASE_URL        the "Transaction pooler" URI (port 6543)
#   DIRECT_DATABASE_URL the "Direct connection" URI (port 5432)
#
# The pooler is what serverless functions connect through; Prisma needs the
# direct connection to run migrations, which pgbouncer cannot proxy.
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&prepared_statements=false
DIRECT_DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- Sessions ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# http://localhost:3000 locally; the deployment's own URL in production.
NEXTAUTH_URL=http://localhost:3000

# ---- The model ----
# Any endpoint that speaks the OpenAI /chat/completions API. Defaults shown are
# Groq's; swap the base URL for https://api.x.ai/v1, https://api.openai.com/v1,
# or http://localhost:11434/v1 for a local Ollama server.
#
# Without AI_API_KEY the app still runs — mail, categories and settings all
# work — and the AI features return a clear "not configured" error.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b

# Reasoning models (Groq's gpt-oss family among them) think before they answer
# and can spend an entire token budget doing it, returning nothing at all. The
# default model is one of those, so this defaults to "low" when unset.
#
# Set it to medium or high for harder work, or to an empty string to stop
# sending the parameter. Providers that do not understand it are detected from
# their own error and retried without it, so this rarely needs touching.
AI_REASONING_EFFORT=low

# ---- Gmail (optional) ----
# Without these the inbox shows a "Connect Gmail" prompt and nothing else.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web),
# with http://localhost:3000/api/gmail/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
