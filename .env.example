# InboxPilot environment variables
# Copy to `.env` (local) or set in Vercel (Settings → Environment Variables).

# ── DATABASE (Supabase — free hosted Postgres) ──────────────────────────────
# SQLite does NOT work on Vercel (ephemeral filesystem). Use Supabase for both
# local dev and production — same connection string.
#
# Setup (2 min):
#   1. Create a free project at https://supabase.com
#   2. Project Settings → Database → Connection string
#   3. Copy the "Transaction pooler" URI (port 6543) → DATABASE_URL
#   4. Copy the "Direct connection" URI (port 5432) → DIRECT_DATABASE_URL
#   5. Run: bun run db:push
#
# DATABASE_URL uses the pooler (with pgbouncer) — required for Vercel serverless.
# DIRECT_DATABASE_URL is a direct connection — used by Prisma for migrations.
DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&prepared_statements=false
DIRECT_DATABASE_URL=postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---- App ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# The canonical app URL (http://localhost:3000 locally; your Vercel URL in prod)
NEXTAUTH_URL=http://localhost:3000

# ---- AI (shared across all users) ----
# xAI Grok API key from https://x.ai. If set, Grok powers all AI features.
# If empty, InboxPilot falls back to its built-in model (no key required).
# All AI endpoints are auth-gated so only logged-in users can consume the key.
GROK_API_KEY=
GROK_MODEL=grok-2-latest

# ---- Gmail OAuth (optional — enables "Connect Gmail") ----
# Create at https://console.cloud.google.com/ — see README "Gmail setup".
# Leave empty to run without Gmail integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
